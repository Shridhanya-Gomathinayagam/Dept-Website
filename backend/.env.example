# Copy to .env and fill in. Never commit .env.
ENV=development
# SQLite file by default (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/dept_hub
# DATABASE_URL=sqlite:///./dept_hub.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# true in production (HTTPS)
COOKIE_SECURE=false
# Required: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (Cloudinary dashboard -> API Keys)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=dept-hub
